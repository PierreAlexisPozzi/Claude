{
  "name": "val-des-sapins",
  "private": true,
  "version": "1.0.0",
  "description": "Val des Sapins — jeu de ski 3D en monde ouvert (projet personnel, non commercial)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "split": "node tools/split-game.mjs",
    "assets": "node tools/build-assets.mjs",
    "test": "npm run build && playwright test",
    "test:only": "playwright test"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "n8ao": "2.1.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/three": "0.187.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "eslint-scope": "9.1.2",
    "jpeg-js": "0.4.4",
    "ktx2-encoder": "0.6.0",
    "magic-string": "1.4.5",
    "meshoptimizer": "1.3.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
